# Hugging Face Inference Providers Configuration
# Create a fine-grained token at: https://huggingface.co/settings/tokens
# Required permissions: Inference -> "Make calls to Inference Providers"
HF_TOKEN=

# Model and Provider selection
HF_MODEL=zai-org/GLM-5.3-Flash
HF_PROVIDER=novita
HF_ROUTING_POLICY=provider

# Language setting: en-GB (British English) or en-US (American English)
ALT_TEXT_LANGUAGE=en-GB

# Operational and reliability limits
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_REQUESTS=2
AI_MAX_OUTPUT_TOKENS=500

# Multimodal inference image preprocessing & payload guardrails
AI_MAX_IMAGE_DIMENSION=1536
AI_MAX_PAYLOAD_BYTES=3500000
AI_JPEG_QUALITY=85

# Application-level monthly spending guardrail in USD
AI_MAX_MONTHLY_SPEND_USD=2.00

# Live integration test toggle (set to true only for opt-in live API tests)
AI_ENABLE_LIVE_TESTS=false

# ============================================================
# Authentication, Session Security, and CORS (Production)
# ============================================================
# Keep AUTH_ENABLED=false in local development; MUST be true in production
AUTH_ENABLED=false

# Required when AUTH_ENABLED=true (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
# Must be at least 32 bytes of high-entropy random data; never commit real secrets
SESSION_SECRET_KEY=

# Session lifetime in seconds (default: 28800 = 8 hours)
SESSION_COOKIE_MAX_AGE=28800

# Comma-separated allowlist of origins (no wildcards '*' allowed)
# Local dev default: http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============================================================
# Production Database & Storage (Vercel + Neon + Vercel Blob)
# ============================================================
DATABASE_URL=
NEON_DB_URL=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
