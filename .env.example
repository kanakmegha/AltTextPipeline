# Hugging Face Inference Providers Configuration
# Create a fine-grained token at: https://huggingface.co/settings/tokens
# Required permissions: Inference -> "Make calls to Inference Providers"
HF_TOKEN=

# Model and Provider selection
HF_MODEL=zai-org/GLM-5.3-Flash
HF_PROVIDER=novita
HF_ROUTING_POLICY=provider

# Language setting: en-GB (British English) or en-US (American English)
ALT_TEXT_LANGUAGE=en-GB

# Operational and reliability limits
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_REQUESTS=2
AI_MAX_OUTPUT_TOKENS=500

# Multimodal inference image preprocessing & payload guardrails
AI_MAX_IMAGE_DIMENSION=1536
AI_MAX_PAYLOAD_BYTES=3500000
AI_JPEG_QUALITY=85

# Application-level monthly spending guardrail in USD
AI_MAX_MONTHLY_SPEND_USD=2.00

# Live integration test toggle (set to true only for opt-in live API tests)
AI_ENABLE_LIVE_TESTS=false
