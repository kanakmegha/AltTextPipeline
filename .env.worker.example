# Copy to .env.worker and fill in real values. Keep credentials private.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
BLOB_STORE_ID=store_id

# Polling and bounded extraction resources
WORKER_POLL_SECONDS=5
PDF_BATCH_SIZE=5
MAX_PARALLEL_BATCHES=2
MAX_RETRIES=3
WORKER_MAX_MEMORY_MB=2048
WORKER_MAX_CPU=2

# Optional Redis Streams transport; PostgreSQL polling works without it.
REDIS_URL=
