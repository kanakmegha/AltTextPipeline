{
  "version": 2,
  "builds": [
    {
      "src": "api/blob-upload.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/upload-and-extract",
      "methods": ["POST"],
      "status": 410
    },
    {
      "src": "/api/blob-upload",
      "dest": "/api/blob-upload.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
